{
  "manifest_version": 3,
  "name": "Trayarunya Copilot",
  "version": "1.0.0",
  "description": "Agentic AI copilot for founders — VC & YC applications, investor outreach, startup credits (Microsoft & more), app-store publishing. Sees pages live, researches, drafts & autofills. Synced to MarketiQ.",
  "homepage_url": "https://mymarketiq.online",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trayarunya Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Toggle the Trayarunya Copilot panel"
    },
    "agent-mode": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open Agent missions"
    },
    "coach-page": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Coach the current page"
    }
  },
  "host_permissions": [
    "https://api.mymarketiq.online/*",
    "https://mymarketiq.online/*",
    "http://localhost:8099/*",
    "http://localhost:3000/*",
    "http://localhost:3100/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://mymarketiq.online/*",
        "http://localhost:3000/*",
        "http://localhost:3100/*"
      ],
      "js": ["content/copilot.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://mymarketiq.online/*",
        "http://localhost:3000/*",
        "http://localhost:3100/*"
      ],
      "js": ["content/webapp-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png", "icons/icon128.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
