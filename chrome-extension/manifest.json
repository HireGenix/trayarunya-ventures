{
  "manifest_version": 3,
  "name": "MarketIQ Universal AI Growth Assistant",
  "version": "2.0.0",
  "description": "Universal AI growth copilot: auto-detects LinkedIn, GA4, GTM, Google/Meta/LinkedIn Ads, Search Console, Shopify, HubSpot & any website — and activates the right agent (tracking audit, event generator, GTM/GA4 copilot, growth audit, LinkedIn growth, fundraising) without manual mode switching.",
  "homepage_url": "https://mymarketiq.online",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MarketIQ Universal AI Growth Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Toggle the MarketIQ copilot panel"
    },
    "agent-mode": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open agent missions for this page"
    },
    "coach-page": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Coach the current page"
    },
    "command-bar": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open the Universal Command Bar"
    }
  },
  "host_permissions": [
    "https://api.mymarketiq.online/*",
    "https://mymarketiq.online/*",
    "http://localhost:8099/*",
    "http://localhost:3000/*",
    "http://localhost:3100/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://mymarketiq.online/*",
        "http://localhost:3000/*",
        "http://localhost:3100/*"
      ],
      "js": [
        "lib/context.js",
        "lib/tracking.js",
        "lib/events.js",
        "lib/agents.js",
        "content/copilot.js"
      ],
      "css": ["content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://mymarketiq.online/*",
        "http://localhost:3000/*",
        "http://localhost:3100/*"
      ],
      "js": ["content/webapp-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png", "icons/icon128.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
