# ---- App ----
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated allowed web origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ---- Database (Azure Database for PostgreSQL flexible server) ----
# Must be the asyncpg driver URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/content_engine

# ---- Redis (Azure Cache for Redis) ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Security at rest (REQUIRED in production) ----
# Stable urlsafe-base64 32-byte Fernet key for encrypting OAuth/integration
# tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Rate limiting (per client IP, per minute) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_DEFAULT_PER_MINUTE=240

# ---- Observability ----
LOG_JSON=true
SENTRY_DSN=

# ---- Background loops ----
# Keep true for single instance. For multi-replica APIs set false and run a
# dedicated process: python -m app.worker.run_loops
RUN_BACKGROUND_LOOPS=true
LEADER_LOCK_TTL_SECONDS=30

# ---- Azure OpenAI (GPT-5.5, Responses API) ----
AZURE_GPT5_ENDPOINT=
AZURE_GPT5_KEY=
AZURE_GPT5_DEPLOYMENT=gpt-5.5
AZURE_GPT5_API_VERSION=2025-04-01-preview

# ---- Azure Anthropic (Claude Opus, Messages API) ----
AZURE_ANTHROPIC_ENDPOINT=https://hiregenix-resource.services.ai.azure.com/anthropic/v1/messages
AZURE_ANTHROPIC_KEY=
AZURE_ANTHROPIC_MODEL=claude-opus-4-7

# ---- Azure Blob (asset storage) ----
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=content-assets

# ---- Azure image generation (decks/PPT + social graphics) ----
# gpt-image (social graphics + studio). Base resource URL, deployment, version.
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_KEY=
AZURE_IMAGE_DEPLOYMENT=gpt-image-2-1
AZURE_IMAGE_15_DEPLOYMENT=gpt-image-1.5
# Per-minute limits (sliding window). Generator auto-overflows to the next
# most-available provider when a budget is exhausted mid-batch (e.g. 20 slides).
IMAGE_RPM=10
IMAGE_15_RPM=60
MAI_IMAGE_RPM=10
FLUX_RPM=4
AZURE_IMAGE_API_VERSION=2024-02-01
# MAI-Image-2.5 — text-free, on-brand imagery (decks/PPT + social graphics).
AZURE_MAI_IMAGE_ENDPOINT=https://hiregenix-resource.services.ai.azure.com
AZURE_MAI_IMAGE_KEY=
AZURE_MAI_IMAGE_DEPLOYMENT=MAI-Image-2.5
# Default image provider for social posts / content-calendar / deck imagery.
# One of: mai | gpt-image | flux. Override per request from the UI.
DEFAULT_POST_IMAGE_PROVIDER=mai

# ---- AI Video generation (Content Studio) ----
# Requires the `ffmpeg` + `ffprobe` binaries on the host (brew install ffmpeg /
# apt-get install ffmpeg). Without them, /videos/generate returns a clear 503.
# Voiceover: Azure OpenAI gpt-4o-mini-tts. Captions: Azure OpenAI Whisper.
# If left blank, TTS/Whisper fall back to the AZURE_GPT5_* resource above.
AZURE_TTS_ENDPOINT=
AZURE_TTS_KEY=
AZURE_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_TTS_API_VERSION=2025-03-01-preview
AZURE_TTS_VOICE=alloy
AZURE_WHISPER_ENDPOINT=
AZURE_WHISPER_KEY=
AZURE_WHISPER_DEPLOYMENT=whisper
AZURE_WHISPER_API_VERSION=2024-06-01
# Pexels stock b-roll — free key at https://www.pexels.com/api/
PEXELS_API_KEY=
# Where rendered videos are written when Azure Blob is not configured.
MEDIA_ROOT=media

# ---- OAuth: public callback base (THIS API's public URL) ----
# Callbacks are <base>/api/v1/<service>/<provider>/callback. Must be https in prod.
OAUTH_REDIRECT_BASE=http://localhost:8099

# ---- Integrations hub OAuth (CRM / analytics / ecommerce) ----
# Optional: enables one-click "Connect" for these providers. Without them the
# hub still works via manual API-token connect. See OAUTH_SETUP.md.
# Redirect URL to register: <OAUTH_REDIRECT_BASE>/api/v1/integrations/<provider>/oauth/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# GA4 + Search Console use the Google OAuth client below (shared).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
